{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "roelofjuniorhaar.vercel.app"
        }
      ],
      "destination": "https://roelofjuniorhaar.marketing/:path*",
      "permanent": true
    },
    {
      "source": "/kerf.sh",
      "destination": "https://raw.githubusercontent.com/BEMBOOMER/kerf-releases/main/install.sh",
      "permanent": false
    },
    {
      "source": "/kerf",
      "destination": "/app-development/kerf/",
      "permanent": false
    },
    {
      "source": "/krijt",
      "destination": "/app-development/krijt/",
      "permanent": false
    },
    {
      "source": "/video-editing/personal-projects/doova/:path*",
      "destination": "/app-development/doova/",
      "permanent": true
    },
    {
      "source": "/video-editing/personal-projects/:path*",
      "destination": "/visual-marketing/",
      "permanent": true
    },
    {
      "source": "/video-marketing/personal-projects/:path*",
      "destination": "/visual-marketing/",
      "permanent": true
    },
    {
      "source": "/video-marketing/:path*",
      "destination": "/visual-marketing/:path*",
      "permanent": true
    },
    {
      "source": "/video-editing/:path*",
      "destination": "/visual-marketing/:path*",
      "permanent": true
    },
    {
      "source": "/social-marketing/:path*",
      "destination": "/visual-marketing/:path*",
      "permanent": true
    },
    {
      "source": "/visual-motion/doova/:path*",
      "destination": "/app-development/doova/",
      "permanent": true
    },
    {
      "source": "/visual-motion/zet-m-op-motion-ad/:path*",
      "destination": "/visual-marketing/zet-m-op/",
      "permanent": true
    },
    {
      "source": "/visual-motion/zet-m-op-verhaal-promo/:path*",
      "destination": "/visual-marketing/zet-m-op/",
      "permanent": true
    },
    {
      "source": "/visual-motion/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
